@inject HubService Hub
@inject GameStateService GameState
@inject ToastService Toast
@inject SettingsService Settings
@inject PlayerSettingsService PlayerSettings
@inject NavigationManager Nav
@inject SavedSessionService SavedSession
@inject GameRegistry Registry
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable

<ToastContainer />
<ActivityLogDrawer @ref="_logDrawer" />
<AddToHomeScreenModal Open="_addToPhoneOpen" OpenChanged="OnAddToPhoneOpenChanged" />

@* ── Header bar ──────────────────────────────────────────────────────────── *@
<header class="@HeaderClass @(_menuOpen ? "fortress-header-interactive" : "")" style="z-index:100">
    <div class="flex items-center gap-2 px-3 h-12 max-w-3xl mx-auto w-full">

        @* QR scan *@
        <button @onclick="TriggerQrScan"
                class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-gray-700 transition-all shrink-0"
                title="Scan a friend's QR code">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h6v6H3zM3 15h6v6H3zM15 3h6v6h-6z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15h2v2h-2zM15 19h2v2h-2zM19 15h2v2h-2zM19 19h2v2h-2z"/>
            </svg>
        </button>

        @* Start Here / Friends / Room code button *@
        <button @onclick="OpenJoinModal"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold shrink-0 transition-all active:scale-95
                       @(GameState.PlatformState is not null
                           ? "bg-gray-700 text-white hover:bg-gray-600 font-mono tracking-wide"
                           : "bg-yellow-400 text-black hover:bg-yellow-300")">
            @if (GameState.PlatformState?.RoomCode is { } rc)
            {
                @rc
            }
            else if (!string.IsNullOrEmpty(GameState.PlayerName))
            {
                <text>Friends</text>
            }
            else
            {
                <text>Start Here</text>
            }
        </button>

        @* Host-left alert *@
        @if (HostHasLeft)
        {
            <button @onclick="() => _hostLeftOpen = true"
                    class="p-1 rounded-full bg-red-600 text-white text-xs font-black w-6 h-6 flex items-center justify-center shrink-0 animate-pulse"
                    title="Host has disconnected">!</button>
        }

        <div class="flex-1" />

        @* Hamburger *@
        <div class="relative shrink-0">
            <button @onclick="ToggleMenu"
                    class="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-gray-700 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>

            @if (_menuOpen)
            {
                <div class="fixed inset-0" style="z-index:98" @onclick="CloseMenu"></div>
                <div class="absolute right-0 top-full mt-1 w-52 bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" style="z-index:99">
                    <button @onclick="OpenSettings"
                            class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-300 hover:bg-gray-800 transition-all text-left">
                        ⚙️ Global Settings
                    </button>
                    @if (GameState.PlatformState is not null)
                    {
                        <button @onclick="OpenGameSettings"
                                class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-300 hover:bg-gray-800 transition-all text-left">
                            🎮 Game Settings
                        </button>
                    }
                    <label class="flex items-center gap-3 px-4 py-3 text-sm text-gray-300 hover:bg-gray-800 cursor-pointer">
                        <input type="checkbox" checked="@Settings.StickyHeader" @onchange="ToggleStickyHeader" class="accent-yellow-400" />
                        Sticky header
                    </label>
                    <button @onclick="OpenLog"
                            class="w-full flex items-center justify-between px-4 py-3 text-sm text-gray-300 hover:bg-gray-800 transition-all text-left">
                        <span>📋 Activity Log</span>
                        @if (Toast.Log.Count > 0)
                        {
                            <span class="text-[10px] bg-gray-700 text-gray-400 px-1.5 py-0.5 rounded-full tabular-nums">@Toast.Log.Count</span>
                        }
                    </button>
                    @if (_showAddToPhone)
                    {
                        <button @onclick="OpenAddToPhone"
                                class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-300 hover:bg-gray-800 transition-all text-left">
                            📲 Add to Phone
                        </button>
                    }
                    @if (GameState.PlatformState is not null)
                    {
                        <div class="border-t border-gray-700 mt-1 pt-1 px-4 py-2 flex flex-col items-start gap-1">
                            @if (GameState.PlatformState.Phase != GamePhase.Lobby)
                            {
                                <button @onclick="LeaveGame" class="text-xs text-gray-600 hover:text-amber-400 transition-all"
                                        title="Back to the main menu — stays in the room, resume any time.">
                                    Leave Game
                                </button>
                            }
                            <button @onclick="LeaveRoom" class="text-xs text-gray-600 hover:text-red-400 transition-all"
                                    title="Leaves the room entirely — not resumable.">
                                Leave Room
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (_reconnecting)
    {
        <div class="bg-yellow-500 text-black text-center text-xs font-semibold py-1">Reconnecting…</div>
    }
</header>

@* ── Join Friends modal ───────────────────────────────────────────────────── *@
@if (_joinOpen)
{
    <div class="fixed inset-0 bg-black/70 flex items-center justify-center z-[110] p-4" @onclick="() => _joinOpen = false">
        <div class="bg-gray-900 border border-gray-700 rounded-2xl p-6 w-full max-w-sm shadow-2xl" @onclick:stopPropagation>

            @* Room info if already in one *@
            @if (GameState.PlatformState is { } ps)
            {
                var meHost = ps.Players.Any(p => p.IsHost && p.Name == GameState.PlayerName);
                <div class="mb-5">
                    <div class="flex items-center justify-between mb-1">
                        <p class="text-xs text-gray-500 uppercase tracking-widest font-semibold">Current Room</p>
                        @if (meHost)
                        {
                            <span class="text-xs text-yellow-400 font-semibold">👑 Creator</span>
                        }
                    </div>
                    <p class="text-2xl font-black text-white font-mono tracking-widest">@ps.RoomCode</p>

                    @* QR code *@
                    <div class="mt-3 flex justify-center">
                        <img src="@QrCodeUrl" alt="Room QR" class="w-32 h-32 rounded-xl border border-gray-700" loading="lazy" />
                    </div>
                    <p class="text-[10px] text-gray-600 text-center mt-1">Friends scan this to join</p>

                    @* Player list *@
                    <div class="mt-4 space-y-1">
                        @foreach (var p in ps.Players)
                        {
                            var canDropFromGame = ps.Phase != GamePhase.Lobby && p.Name != GameState.PlayerName
                                && (meHost || (p.IsHost && p.AwayFromGame));
                            var canDropFromRoom = meHost && p.Name != GameState.PlayerName && !p.IsBot;
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full shrink-0 @(p.IsConnected ? "bg-green-400" : "bg-gray-600")"></span>
                                <span class="text-sm flex-1 @(p.IsConnected ? "text-gray-200" : "text-gray-600") @(p.IsBot ? "italic" : "")">
                                    @p.Name
                                    @if (p.AwayFromGame) { <span class="text-amber-400 text-xs">(away)</span> }
                                </span>
                                @if (p.IsHost) { <span class="text-yellow-400 text-xs">👑</span> }
                                @if (p.IsBot) { <span class="text-gray-500 text-xs">🤖</span> }
                                @if (canDropFromGame)
                                {
                                    <button @onclick='() => DropPlayer(p.Name, "game")'
                                            class="text-[10px] px-1.5 py-0.5 rounded bg-gray-800 text-amber-400 hover:bg-gray-700"
                                            title="Drop from the current game — they stay in the room.">
                                        Drop game
                                    </button>
                                }
                                @if (canDropFromRoom)
                                {
                                    <button @onclick='() => DropPlayer(p.Name, "room")'
                                            class="text-[10px] px-1.5 py-0.5 rounded bg-gray-800 text-red-400 hover:bg-gray-700"
                                            title="Remove them from the room entirely.">
                                        Drop room
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* Navigation *@
                    @if (ps.Phase == GamePhase.Lobby)
                    {
                        <button @onclick="PickGame"
                                class="mt-4 w-full py-2.5 rounded-xl bg-yellow-400 text-black text-sm font-bold hover:bg-yellow-300 active:scale-95 transition-all">
                            🎮 Pick a game to play!
                        </button>
                    }
                    else
                    {
                        <button @onclick="GoToGame"
                                class="mt-4 w-full py-2.5 rounded-xl bg-gray-700 text-white text-sm font-semibold hover:bg-gray-600 transition-all">
                            ↩ Back to Game
                        </button>
                    }

                    <div class="border-t border-gray-800 mt-4 pt-3">
                        <p class="text-xs text-gray-500 uppercase tracking-widest mb-3">Join a different room</p>
                        <input @bind="_code" @bind:event="oninput"
                               @onkeydown="OnJoinKeyDown"
                               placeholder="Room code or fun name"
                               maxlength="32"
                               class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm font-mono uppercase tracking-wide placeholder-gray-600 placeholder:normal-case placeholder:tracking-normal focus:outline-none focus:border-yellow-400 mb-3" />
                        <button @onclick="OnJoinClick"
                                disabled="@(_joining || string.IsNullOrWhiteSpace(_code))"
                                class="w-full py-2.5 rounded-xl text-sm font-bold transition-all
                                       @(_joining ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                                  : string.IsNullOrWhiteSpace(_code)
                                                      ? "bg-gray-800 text-gray-600 cursor-not-allowed"
                                                      : "bg-gray-700 text-white hover:bg-gray-600 active:scale-95")">
                            @(_joining ? "Joining…" : "Join Room")
                        </button>
                    </div>
                </div>
            }
            else if (string.IsNullOrEmpty(GameState.PlayerName))
            {
                @* ── No name yet: prompt for name, then join friend's lobby or create ── *@
                <h2 class="text-lg font-bold text-white mb-4">Start Here</h2>

                @if (HasPendingJoin)
                {
                    <PendingLobbyPreview JoinCode="@GetJoinCode()"
                                         Room="_pendingRoom"
                                         Loading="_pendingRoomLoading"
                                         NotFound="_pendingRoomNotFound" />
                }

                <div class="mb-4">
                    <label class="text-xs text-gray-500 uppercase tracking-wider font-semibold block mb-1">Your name <span class="text-yellow-400 normal-case tracking-normal font-normal">Required</span></label>
                    <input @bind="_name" @bind:event="oninput"
                           @onkeydown="OnStartHereKeyDown"
                           placeholder="Enter your name"
                           maxlength="20"
                           class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-yellow-400" />
                </div>

                @if (HasPendingJoin)
                {
                    <button @onclick="OnJoinWithNameClick"
                            disabled="@(_joining || string.IsNullOrWhiteSpace(_name) || _pendingRoomNotFound)"
                            class="w-full py-2.5 rounded-xl text-sm font-bold transition-all
                                   @(_joining ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                              : "bg-yellow-400 text-black hover:bg-yellow-300 active:scale-95")">
                        @(_joining ? "Joining…" : "Join Lobby")
                    </button>
                }
                else
                {
                    <button @onclick="OnCreateClick"
                            disabled="@(_creating || string.IsNullOrWhiteSpace(_name))"
                            class="w-full py-2.5 rounded-xl text-sm font-bold transition-all
                                   @(_creating ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                               : "bg-yellow-400 text-black hover:bg-yellow-300 active:scale-95")">
                        @(_creating ? "Creating…" : "Create Room")
                    </button>
                }

                <button @onclick="CloseJoinModal"
                        class="w-full mt-2 py-2 rounded-xl text-xs text-gray-600 hover:text-gray-400 transition-all">
                    Cancel
                </button>
            }
            else if (HasPendingJoin)
            {
                @* ── Has name, invite pending: join that lobby only ── *@
                <h2 class="text-lg font-bold text-white mb-1">Join Friends</h2>
                <p class="text-xs text-gray-500 mb-4">Playing as <span class="text-white font-semibold">@GameState.PlayerName</span></p>

                <PendingLobbyPreview JoinCode="@GetJoinCode()"
                                     Room="_pendingRoom"
                                     Loading="_pendingRoomLoading"
                                     NotFound="_pendingRoomNotFound" />

                <button @onclick="OnJoinClick"
                        disabled="@(_joining || _pendingRoomNotFound)"
                        class="w-full py-2.5 rounded-xl text-sm font-bold transition-all mb-2
                               @(_joining ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                          : "bg-yellow-400 text-black hover:bg-yellow-300 active:scale-95")">
                    @(_joining ? "Joining…" : "Join Lobby")
                </button>

                <button @onclick="CloseJoinModal"
                        class="w-full py-2 rounded-xl text-xs text-gray-600 hover:text-gray-400 transition-all">
                    Cancel
                </button>
            }
            else
            {
                @* ── Has name, no room: split Create / Join ── *@
                <h2 class="text-lg font-bold text-white mb-1">Create Room or Join Friends</h2>
                <p class="text-xs text-gray-500 mb-5">Playing as <span class="text-white font-semibold">@GameState.PlayerName</span></p>

                @* Create section *@
                <button @onclick="OnCreateClick"
                        disabled="@_creating"
                        class="w-full py-3 rounded-xl text-sm font-bold transition-all mb-5
                               @(_creating ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                           : "bg-yellow-400 text-black hover:bg-yellow-300 active:scale-95")">
                    @(_creating ? "Creating…" : "Create Room")
                </button>

                @* Divider *@
                <div class="flex items-center gap-3 mb-4">
                    <div class="flex-1 h-px bg-gray-700"></div>
                    <span class="text-xs text-gray-600 uppercase tracking-widest">or join</span>
                    <div class="flex-1 h-px bg-gray-700"></div>
                </div>

                @* Join section *@
                <div class="mb-3">
                    <label class="text-xs text-gray-500 uppercase tracking-wider font-semibold block mb-1">Room Code or Fun Name</label>
                    <input @bind="_code" @bind:event="oninput"
                           @onkeydown="OnJoinKeyDown"
                           placeholder="e.g. ABCD or WackyOnion"
                           maxlength="32"
                           class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm font-mono uppercase tracking-wide placeholder-gray-600 placeholder:normal-case placeholder:tracking-normal focus:outline-none focus:border-yellow-400" />
                </div>

                <label class="flex items-center gap-2 mb-4 cursor-pointer select-none">
                    <input type="checkbox" @bind="_useFunName" class="accent-yellow-400" />
                    <span class="text-sm text-gray-400">Use a fun room name</span>
                    <span class="text-gray-600 text-xs cursor-help"
                          title="Instead of a random code like 'XKQZ', your room gets a memorable name like 'WackyOnion'. Much easier to share!">ⓘ</span>
                </label>

                <button @onclick="OnJoinClick"
                        disabled="@(_joining || string.IsNullOrWhiteSpace(_code))"
                        class="w-full py-2.5 rounded-xl text-sm font-bold transition-all
                               @(_joining ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                          : string.IsNullOrWhiteSpace(_code)
                                              ? "bg-gray-800 text-gray-600 cursor-not-allowed"
                                              : "bg-gray-700 text-white hover:bg-gray-600 active:scale-95")">
                    @(_joining ? "Joining…" : "Join Room")
                </button>

                <button @onclick="() => _joinOpen = false"
                        class="w-full mt-2 py-2 rounded-xl text-xs text-gray-600 hover:text-gray-400 transition-all">
                    Cancel
                </button>
            }

        </div>
    </div>
}

@* ── Host-left prompt ─────────────────────────────────────────────────────── *@
@if (_hostLeftOpen)
{
    var hostName = GameState.PlatformState?.Players.FirstOrDefault(p => p.IsHost)?.Name ?? "the host";
    <div class="fixed inset-0 bg-black/70 flex items-center justify-center z-[120] p-4" @onclick="() => _hostLeftOpen = false">
        <div class="bg-gray-900 border border-red-700 rounded-2xl p-6 w-full max-w-sm shadow-2xl" @onclick:stopPropagation>
            <div class="text-center mb-4">
                <span class="text-3xl">👑</span>
                <h3 class="text-lg font-bold text-white mt-2">Creator has left</h3>
                <p class="text-sm text-gray-400 mt-1">@hostName has disconnected</p>
            </div>
            <div class="flex flex-col gap-2">
                <button @onclick="TakeOverAsHost"
                        disabled="@_promotingHost"
                        class="w-full py-2.5 rounded-xl bg-yellow-400 text-black text-sm font-bold hover:bg-yellow-300 active:scale-95 transition-all">
                    @(_promotingHost ? "Taking over…" : "Take over as Creator")
                </button>
                <button @onclick="() => _hostLeftOpen = false"
                        class="w-full py-2 rounded-xl text-xs text-gray-500 hover:text-gray-300 transition-all">
                    Wait for @hostName to return
                </button>
            </div>
        </div>
    </div>
}

@* ── Game Settings modal ──────────────────────────────────────────────────── *@
@if (_gameSettingsOpen)
{
    <div class="fixed inset-0 bg-black/70 flex items-center justify-center z-[115] p-4" @onclick="() => _gameSettingsOpen = false">
        <div class="bg-gray-900 rounded-2xl w-full max-w-sm shadow-2xl border border-gray-700 p-6" @onclick:stopPropagation>
            <h2 class="text-lg font-bold text-white mb-1">Game Settings</h2>
            <p class="text-xs text-gray-500 mb-5">Saved to your profile. Applied when the next game starts.</p>

            @if (GameState.PlatformState?.GameType == "OneO")
            {
                <div class="space-y-4">
                    <label class="flex items-center justify-between gap-4 cursor-pointer">
                        <div>
                            <p class="text-sm font-semibold text-white">Numbers Only</p>
                            <p class="text-xs text-gray-500 mt-0.5">Remove all special cards — Skips, Reverses, Draw Twos, and Wilds.</p>
                        </div>
                        <input type="checkbox"
                               checked="@PlayerSettings.OneONumbersOnly"
                               @onchange="OnGameSettingsNumbersOnlyChanged"
                               class="w-5 h-5 accent-yellow-400 shrink-0" />
                    </label>
                </div>
            }
            else
            {
                <p class="text-gray-500 text-sm">No settings available for this game yet.</p>
            }

            <button @onclick="() => _gameSettingsOpen = false"
                    class="mt-6 w-full py-2.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-white text-sm font-semibold transition-all">
                Done
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSettingsOpen { get; set; }

    private ActivityLogDrawer? _logDrawer;
    private string _code = "";
    private string _name = "";
    private bool _useFunName;
    private bool _creating;
    private bool _joining;
    private bool _promotingHost;
    private bool _menuOpen;
    private bool _reconnecting;
    private bool _joinOpen;
    private bool _hostLeftOpen;
    private bool _gameSettingsOpen;
    private bool _addToPhoneOpen;
    private bool _showAddToPhone;
    private RoomInfoDto? _pendingRoom;
    private bool _pendingRoomLoading;
    private bool _pendingRoomNotFound;

    private bool HasPendingJoin => !string.IsNullOrWhiteSpace(GetJoinCode());

    private string GetJoinCode() =>
        (GameState.PendingJoinCode ?? _code).Trim().ToUpperInvariant();

    private bool HostHasLeft =>
        GameState.PlatformState is { } ps &&
        ps.Players.Any(p => p.IsHost && !p.IsConnected && !p.IsBot) &&
        !ps.Players.Any(p => p.IsHost && p.IsConnected && !p.IsBot) &&
        ps.Players.Any(p => p.Name == GameState.PlayerName && !p.IsHost);

    private string HeaderClass =>
        Settings.StickyHeader
            ? "sticky top-0 bg-gray-950/95 backdrop-blur-sm border-b border-gray-800 w-full"
            : "relative bg-gray-950/95 border-b border-gray-800 w-full";

    private string QrCodeUrl
    {
        get
        {
            var code = GameState.PlatformState?.RoomCode;
            if (code is null) return "";
            var joinUrl = Nav.ToAbsoluteUri($"/?join={code}").ToString();
            return $"https://api.qrserver.com/v1/create-qr-code/?size=128x128&data={Uri.EscapeDataString(joinUrl)}";
        }
    }

    protected override void OnInitialized()
    {
        Hub.OnReconnecting += OnHubReconnecting;
        Hub.OnReconnected += OnHubReconnected;
        Hub.OnGameState += OnGameStateReceived;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RefreshAddToPhoneVisibilityAsync();
    }

    private async Task RefreshAddToPhoneVisibilityAsync()
    {
        try
        {
            _showAddToPhone = await JS.InvokeAsync<bool>("gameInterop.shouldShowAddToPhone");
        }
        catch
        {
            _showAddToPhone = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAddToPhone()
    {
        _menuOpen = false;
        await RefreshAddToPhoneVisibilityAsync();
        if (_showAddToPhone)
            _addToPhoneOpen = true;
    }

    private Task OnAddToPhoneOpenChanged(bool open)
    {
        _addToPhoneOpen = open;
        if (!open)
            _ = RefreshAddToPhoneVisibilityAsync();
        return Task.CompletedTask;
    }

    /// <summary>Opens the join modal with a room code pre-filled (e.g. from QR or invite URL).</summary>
    public void BeginJoin(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;
        var normalized = code.Trim().ToUpperInvariant();
        GameState.PendingJoinCode = normalized;
        _code = normalized;
        _joinOpen = true;
        _ = LoadPendingRoomPreviewAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenJoinModal()
    {
        if (!string.IsNullOrEmpty(GameState.PendingJoinCode))
            _code = GameState.PendingJoinCode;
        _joinOpen = true;
        if (HasPendingJoin)
            await LoadPendingRoomPreviewAsync();
    }

    private void CloseJoinModal()
    {
        _joinOpen = false;
    }

    private async Task LoadPendingRoomPreviewAsync()
    {
        var code = GetJoinCode();
        if (string.IsNullOrWhiteSpace(code)) return;

        _pendingRoomLoading = true;
        _pendingRoomNotFound = false;
        _pendingRoom = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var resp = await Http.GetFromJsonAsync<RoomInfoDto>($"/api/rooms/{code}/info");
            if (resp is null)
            {
                _pendingRoomNotFound = true;
            }
            else
            {
                _pendingRoom = resp;
                GameState.SelectedGameType = resp.GameType;
            }
        }
        catch
        {
            _pendingRoomNotFound = true;
        }
        finally
        {
            _pendingRoomLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> SavePlayerNameAsync(string playerName)
    {
        if (string.IsNullOrWhiteSpace(playerName)) return false;
        GameState.PlayerName = playerName;
        await JS.InvokeVoidAsync("localStorage.setItem", "sad_name", playerName);
        return true;
    }

    private async Task EnterLobbyAfterJoinAsync(string? roomCode, string playerName, string verb)
    {
        GameState.PendingJoinCode = null;
        _code = "";
        _pendingRoom = null;
        _joinOpen = false;
        Toast.Success($"{verb} room {roomCode}!");
        Toast.LogEvent($"{verb} room {roomCode} as {playerName}", "Room");
        await JS.InvokeVoidAsync("gameInterop.playSound", "confirm");
        Nav.NavigateTo("/room");
    }

    /// <summary>Room creation from the "Start Here" modal stays put — just dismiss the modal and let
    /// the header badge reflect the new room code, rather than yanking the player to /room. Joining
    /// (an existing friend's lobby) still navigates there since that's the point of joining.</summary>
    private async Task DismissModalAfterCreateAsync(string? roomCode, string playerName)
    {
        GameState.PendingJoinCode = null;
        _code = "";
        _pendingRoom = null;
        _joinOpen = false;
        Toast.Success($"Created room {roomCode}!");
        Toast.LogEvent($"Created room {roomCode} as {playerName}", "Room");
        await JS.InvokeVoidAsync("gameInterop.playSound", "confirm");
    }

    private void OnHubReconnecting()
    {
        _reconnecting = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnHubReconnected()
    {
        _reconnecting = false;
        InvokeAsync(StateHasChanged);
    }

    private GamePhase? _lastPhase;

    private async Task OnGameStateReceived(GameStateDto state)
    {
        GameState.UpdatePlatform(state);

        if (_lastPhase != state.Phase)
        {
            if (state.Phase == GamePhase.Playing)
                Toast.LogEvent($"Game started in room {state.RoomCode}", "Game", ToastLevel.Success);
            else if (state.Phase == GamePhase.GameOver)
                Toast.LogEvent($"Game over in room {state.RoomCode}", "Game");
            _lastPhase = state.Phase;
        }

        // Auto-navigate to game room when game starts
        if (state.Phase != GamePhase.Lobby && state.Phase != GamePhase.GameOver)
        {
            if (!Nav.Uri.Contains("/room"))
                await InvokeAsync(() => Nav.NavigateTo("/room"));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCreateClick()
    {
        if (HasPendingJoin)
        {
            Toast.Warn("You're joining a friend's lobby — use Join Lobby.");
            return;
        }

        var playerName = string.IsNullOrWhiteSpace(GameState.PlayerName) ? _name.Trim() : GameState.PlayerName;
        if (string.IsNullOrWhiteSpace(playerName)) { Toast.Warn("Enter your name first."); return; }
        if (!await SavePlayerNameAsync(playerName)) return;

        _creating = true;
        StateHasChanged();
        try
        {
            await Hub.EnsureConnectedAsync();
            var gameType = GameState.SelectedGameType ?? "standup";
            var result = await Hub.CreateOrJoinAsync(null, playerName, gameType, _useFunName);
            if (result.Success)
            {
                var roomCode = result.RoomCode ?? GameState.PlatformState?.RoomCode;
                await DismissModalAfterCreateAsync(roomCode, playerName);
            }
            else { Toast.Error(result.Error ?? "Failed to create room."); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _creating = false; }
    }

    private async Task OnJoinWithNameClick()
    {
        var playerName = _name.Trim();
        if (string.IsNullOrWhiteSpace(playerName)) { Toast.Warn("Enter your name first."); return; }
        var code = GetJoinCode();
        if (string.IsNullOrWhiteSpace(code)) { Toast.Warn("Enter a room code or fun name."); return; }
        if (_pendingRoomNotFound) { Toast.Error("That room no longer exists."); return; }
        if (!await SavePlayerNameAsync(playerName)) return;

        _joining = true;
        StateHasChanged();
        try
        {
            await Hub.EnsureConnectedAsync();
            var result = await Hub.JoinAsync(code, playerName);
            if (result.Success)
                await EnterLobbyAfterJoinAsync(result.RoomCode ?? GameState.PlatformState?.RoomCode ?? code, playerName, "Joined");
            else { Toast.Error(result.Error ?? "Failed to join."); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _joining = false; }
    }

    private async Task OnJoinClick()
    {
        var playerName = GameState.PlayerName;
        if (string.IsNullOrWhiteSpace(playerName)) { Toast.Warn("Enter your name first."); return; }
        var code = GetJoinCode();
        if (string.IsNullOrWhiteSpace(code)) { Toast.Warn("Enter a room code or fun name."); return; }
        if (_pendingRoomNotFound) { Toast.Error("That room no longer exists."); return; }

        _joining = true;
        StateHasChanged();
        try
        {
            await Hub.EnsureConnectedAsync();
            var result = await Hub.JoinAsync(code, playerName);
            if (result.Success)
                await EnterLobbyAfterJoinAsync(result.RoomCode ?? GameState.PlatformState?.RoomCode ?? code, playerName, "Joined");
            else { Toast.Error(result.Error ?? "Failed to join."); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _joining = false; }
    }

    private async Task TriggerQrScan()
    {
        try
        {
            var result = await JS.InvokeAsync<string?>("gameInterop.scanQrCode");
            if (!string.IsNullOrEmpty(result))
            {
                var code = ExtractCodeFromUrl(result) ?? result.Trim().ToUpperInvariant();
                GameState.PendingJoinCode = code;
                if (string.IsNullOrEmpty(GameState.PlayerName))
                    BeginJoin(code);
                else
                {
                    _code = code;
                    _joinOpen = true;
                    await LoadPendingRoomPreviewAsync();
                }
            }
        }
        catch (Exception ex) when (!ex.Message.Contains("Cancelled"))
        {
            Toast.Warn("QR scan requires Chrome or Edge. Type the code manually.");
        }
    }

    private static string ExtractCodeFromUrl(string value)
    {
        try
        {
            var uri = new Uri(value);
            foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = pair.Split('=');
                if (kv.Length == 2)
                {
                    var key = Uri.UnescapeDataString(kv[0]).ToLowerInvariant();
                    if (key is "join" or "code")
                        return Uri.UnescapeDataString(kv[1]).ToUpperInvariant();
                }
            }
        }
        catch { }
        return value.Trim().ToUpperInvariant();
    }

    private void PickGame()
    {
        _joinOpen = false;
        var code = GameState.PlatformState?.RoomCode;
        Nav.NavigateTo(code is not null ? $"/?room={code}" : "/");
    }

    private void GoToGame()
    {
        _joinOpen = false;
        Nav.NavigateTo("/room");
    }

    private async Task DropPlayer(string targetPlayerName, string scope)
    {
        var result = await Hub.DropPlayerAsync(targetPlayerName, scope);
        if (result.Success)
            Toast.LogEvent($"{targetPlayerName} dropped from the {(scope == "room" ? "room" : "game")}", "Room", ToastLevel.Warning);
        else
            Toast.Error(result.Error ?? "Could not drop player.");
    }

    private async Task TakeOverAsHost()
    {
        _promotingHost = true;
        var result = await Hub.PromoteToHostAsync();
        _promotingHost = false;
        _hostLeftOpen = false;
        if (result.Success)
            Toast.Success("You are now the Creator!");
        else
            Toast.Error(result.Error ?? "Could not take over as host.");
    }

    /// <summary>"Leave Game" — back to the main menu, but stays a room member (SignalR group
    /// membership untouched, saved session kept) so "Resume Last Session" brings them right back.</summary>
    private async Task LeaveGame()
    {
        _menuOpen = false;
        var code = GameState.PlatformState?.RoomCode;
        await Hub.LeaveGameAsync();
        if (code is not null)
            Toast.LogEvent($"Left the game in room {code} — resume any time", "Room");
        Nav.NavigateTo("/");
    }

    /// <summary>"Leave Room" — full exit. Removes the player from the room outright (server purges
    /// the room immediately if that was the last human) and forgets the saved room so no "Resume"
    /// option is offered.</summary>
    private async Task LeaveRoom()
    {
        _menuOpen = false;
        var code = GameState.PlatformState?.RoomCode;
        if (code is not null)
        {
            Toast.LogEvent($"Left room {code}", "Room", ToastLevel.Warning);
            await Hub.LeaveRoomPermanentlyAsync(code);
        }
        await SavedSession.ClearAsync();
        GameState.Clear();
        _lastPhase = null;
        Nav.NavigateTo("/");
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void OpenLog()
    {
        _menuOpen = false;
        _logDrawer?.Open();
    }

    private async Task OpenSettings()
    {
        _menuOpen = false;
        await OnSettingsOpen.InvokeAsync();
    }

    private async Task OpenGameSettings()
    {
        _menuOpen = false;
        await PlayerSettings.LoadAsync();
        _gameSettingsOpen = true;
    }

    private async Task OnGameSettingsNumbersOnlyChanged(ChangeEventArgs e)
    {
        var v = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var pv) && pv;
        await PlayerSettings.SetOneONumbersOnlyAsync(v);
    }

    private async Task ToggleStickyHeader(ChangeEventArgs e)
    {
        var v = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var pv) && pv;
        await Settings.SetStickyHeaderAsync(v);
    }

    private async Task OnJoinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnJoinClick();
    }

    private async Task OnStartHereKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (!string.IsNullOrWhiteSpace(_code))
            await OnJoinWithNameClick();
        else
            await OnCreateClick();
    }

    public void Dispose()
    {
        Hub.OnReconnecting -= OnHubReconnecting;
        Hub.OnReconnected -= OnHubReconnected;
        Hub.OnGameState -= OnGameStateReceived;
    }
}
