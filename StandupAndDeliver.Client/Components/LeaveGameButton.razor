@inject NavigationManager Nav
@inject GameStateService GameState
@inject HubService Hub

@* "Leave Game" — the player stays a member of the room/SignalR group and keeps their saved
   session, so the home screen's "Resume Last Session" card can bring them straight back. This is
   deliberately NOT a full room exit — that's the hamburger menu's "Leave Room" action. *@
<div class="mt-6 text-center">
    <button @onclick="OnLeave"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-400 transition-all">
        Leave Game
    </button>
</div>

@code {
    private async Task OnLeave()
    {
        await Hub.LeaveGameAsync();
        Nav.NavigateTo("/");
    }
}
