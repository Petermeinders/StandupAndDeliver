@inject GameRegistry Registry

<div class="mb-4 border border-gray-800 rounded-xl p-4 bg-gray-950/50">
    @if (Loading)
    {
        <p class="text-sm text-gray-500">Loading lobby…</p>
    }
    else if (NotFound)
    {
        <p class="text-sm text-red-400">Room <span class="font-mono font-bold">@JoinCode</span> was not found or has expired.</p>
    }
    else if (Room is { } room)
    {
        var gameName = Registry.Get(room.GameType)?.Name ?? room.GameType;
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">Friend's lobby</p>
        <p class="text-2xl font-black text-white font-mono tracking-widest">@room.RoomCode</p>
        <p class="text-sm text-gray-400 mt-1">
            @gameName
            @if (room.Phase == nameof(GamePhase.Lobby))
            {
                <text> · waiting in lobby</text>
            }
            else
            {
                <text> · game in progress</text>
            }
        </p>
        @if (room.Players.Count > 0)
        {
            <div class="mt-3 space-y-1">
                @foreach (var p in room.Players)
                {
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full shrink-0 @(p.IsConnected ? "bg-green-400" : "bg-gray-600")"></span>
                        <span class="text-sm flex-1 @(p.IsConnected ? "text-gray-200" : "text-gray-600")">@p.Name</span>
                        @if (p.IsHost) { <span class="text-yellow-400 text-xs">👑</span> }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">Joining room</p>
        <p class="text-2xl font-black text-white font-mono tracking-widest">@JoinCode</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string JoinCode { get; set; } = "";
    [Parameter] public RoomInfoDto? Room { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool NotFound { get; set; }
}
